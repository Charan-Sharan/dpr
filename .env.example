# Copy this file to .env and replace placeholders. Never commit real keys.
# Configure either provider, or both for fallback and model diversity.
GROQ_API_KEY=your_actual_key_here
OPEN_ROUTER_API_KEY=your_actual_key_here

# auto uses Groq for planning/writing/evidence and OpenRouter for review.
# Either provider can be used alone; the other is a fallback when configured.
DPR_PROVIDER=auto

# Optional per-provider, per-role model overrides:
# DPR_GROQ_MODEL_PLANNER=openai/gpt-oss-20b
# DPR_GROQ_MODEL_WRITER=openai/gpt-oss-120b
# DPR_OPENROUTER_MODEL_SKEPTIC=meta-llama/llama-3.3-70b-instruct
# Optional preferred provider per role:
# DPR_PROVIDER_WRITER=groq

# Optional local server settings (loopback only):
# PORT=8765
# DPR_DB=workspace.sqlite3
